# Standalone bot: no LLM or Helius Wallet API key required.
RPC_URL=https://api.mainnet-beta.solana.com
# MONITOR_RPC_URL=
# MONITOR_WS_URL=
# BALANCE_RPC_URL=
# FALLBACK_RPC_URL=
# Optional watchlist providers. Discoveries run through screening without submitting transactions.
# GMGN_API_KEY=
# HELIUS_API_KEY=
# WALLET_ADDRESS=public_address_for_read_only_operation
# WALLET_PRIVATE_KEY=base58_secret_for_live_signing
DRY_RUN=true
# PNL_SOURCE=meteora
# PNL_RPC_URL=
# JUPITER_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_ALLOWED_USER_IDS=

# Use a dedicated Slack app created from slack-manifest.yaml.
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_APP_ID=
# SLACK_TEAM_ID=
# SLACK_OWNER_USER_ID=
SLACK_ALLOW_LIVE=false
