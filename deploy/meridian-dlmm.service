[Unit]
Description=Meridian DLMM standalone engine and Slack console
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=meridian-dlmm
Group=meridian-dlmm
WorkingDirectory=/opt/meridian-dlmm
ExecStart=/usr/bin/node /opt/meridian-dlmm/index.js
Restart=on-failure
RestartSec=4
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/meridian-dlmm

[Install]
WantedBy=multi-user.target
